APP_NAME=نظام إدارة المخزن
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@localhost:5432/warehouse
SESSION_SECRET=replace-with-a-long-random-value
# Required only for the first seed, then remove it from the environment.
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_COOKIE_NAME=warehouse_session
SESSION_TTL_HOURS=8
# Comma-separated origins only when the frontend is served separately.
CORS_ORIGINS=
