{
  "name": "@workspace/warehouse-desktop",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Warehouse Management"
  },
  "description": "Windows desktop client for the Warehouse Management System",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "dist:dir": "electron-builder --dir",
    "dist:win": "node scripts/build-windows.cjs portable",
    "dist:win:signed": "node scripts/build-windows.cjs portable --require-signing",
    "dist:win:installer": "node scripts/build-windows.cjs nsis",
    "dist:win:installer:signed": "node scripts/build-windows.cjs nsis --require-signing",
    "verify:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-build.ps1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.warehouse.management",
    "productName": "نظام إدارة المخزن",
    "copyright": "Copyright © 2026 Warehouse Management",
    "forceCodeSigning": false,
    "artifactName": "Warehouse-Management-Portable-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "build/icon.ico"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "executableName": "WarehouseManagement",
      "legalTrademarks": "Warehouse Management",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "timeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "Warehouse-Management-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام إدارة المخزن",
      "runAfterFinish": true
    }
  }
}